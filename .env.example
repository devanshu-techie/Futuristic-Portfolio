# ---------------------------------------------------------------
# Devansh Gulati platform — environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------

# Public site address (used in emails, canonical URLs and the sitemap)
SITE_URL=https://devanshugulati.in

# --- Admin sign-in (required) ---
ADMIN_EMAIL=devanshugulati1322@gmail.com
# Initial admin password. After the first sign-in you can change it in Admin → Settings;
# the new password is stored hashed and takes priority over this value.
ADMIN_PASSWORD=

# --- Secrets (required, 32+ random characters each) ---
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
FORM_SECRET=

# --- Storage (required for saving enquiries and content edits) ---
# Created automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# --- Email (choose ONE; without these, FormSubmit is used as a zero-setup fallback) ---
# Option A — Resend (branded emails from your own domain)
RESEND_API_KEY=
EMAIL_FROM=Devansh Gulati <hello@devanshugulati.in>
# Option B — Gmail / any SMTP server (use a Google "App password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Set to "off" to disable the FormSubmit fallback
EMAIL_FALLBACK=
